# ── Supabase ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role bypasses RLS — only used in the Stripe webhook server-side handler
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Site ───────────────────────────────────────────────────────────────────────
# No trailing slash. Used for Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────────────
# Optional but recommended — without these, rate limiting is silently disabled
# (fails open, logs a warning). console.upstash.com → free tier → REST API section.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=...
